{
  "manifest_version": 3,
  "name": "Site Lock",
  "version": "1.0.0",
  "description": "Password-protect the websites you choose.",
  "permissions": ["storage", "declarativeNetRequest", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Site Lock",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["lock.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
