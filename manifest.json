{
  "manifest_version": 3,
  "name": "Site Lock",
  "version": "1.1.0",
  "description": "Lock Instagram, WhatsApp and any site you choose behind a password, even if you forget to lock your laptop.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "alarms",
    "scripting",
    "idle",
    "favicon"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Site Lock",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "commands": {
    "lock-all": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Lock every site now"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lock.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
